# Copy to .env for local development. Placeholder values only — never commit real values.

# ---------------------------------------------------------------------------
# Collector (server-side ONLY: local shell or GitHub Actions secrets)
# ---------------------------------------------------------------------------
# Postgres connection string for the Supabase database (Project Settings → Database).
# This is an administrative credential. Never expose it to the frontend.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Comma-separated source adapters to run. Empty = no collection (default).
# Available: gem_bids_products, gem_bids_services
ENABLED_SOURCES=

# Live GeM requests stay disabled unless GEM_LIVE_ACCESS_APPROVED=true. GeM's gateway blocks
# automated clients (docs/SOURCE_FEASIBILITY.md §3a); set this only after GeM approves access.
GEM_LIVE_ACCESS_APPROVED=false

# Must also be "true" before any GeM data is stored. Set only after obtaining written
# permission from GeM SPV to reproduce listing data (see docs/SOURCE_FEASIBILITY.md).
GEM_REPRODUCTION_PERMISSION_CONFIRMED=false

# Honest identification for outbound requests (include a contact address).
COLLECTOR_USER_AGENT="GeMIntelligenceCollector/1.0 (+mailto:you@example.com)"

REQUEST_TIMEOUT_SECONDS=20
REQUEST_DELAY_SECONDS=3
MAX_RETRIES=3
MAX_PAGES_PER_SOURCE=100
REFRESH_WINDOW_DAYS=2
REFRESH_MAX_PAGES=20
WATERMARK_OVERLAP_HOURS=48
LOG_LEVEL=INFO

# Optional: a disposable local Postgres used by the database tests (never production).
TEST_DATABASE_URL=postgresql://postgres@localhost:54329/gem_test

# ---------------------------------------------------------------------------
# Frontend (public — these values end up in browser JavaScript)
# Only the Supabase project URL and the *anon* (publishable) key belong here.
# NEVER put the service-role key or DATABASE_URL in a VITE_ variable.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
